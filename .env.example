VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
VITE_SITE_URL=https://aivoinsights.com
VITE_GA_MEASUREMENT_ID=
# PostHog website analytics (public pages only; see src/lib/posthogAnalytics.ts).
# Nothing loads unless both are set and the host is https://us.i.posthog.com or https://eu.i.posthog.com.
# The key is the PostHog project's public client key; set it in the hosting env, never in code.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
